# Speaker backends to use; one that finds nothing just lists no rooms.
ROOMCAST_PLAYERS=sonos,cast,dlna
# Room or speaker to play in when a request names none, as list_rooms shows it.
ROOMCAST_DEFAULT_ROOM=Kitchen
# Optional Sonos static map, Name=IP,...; skips multicast discovery for the rooms listed.
ROOMCAST_SONOS_HOSTS=
# Optional Cast device IPs, polled as well as mDNS discovery.
ROOMCAST_CAST_HOSTS=
# Optional DLNA renderer description URLs, used as well as SSDP search.
ROOMCAST_DLNA_HOSTS=

# Address to listen on. 127.0.0.1 is enough for Tailscale Funnel or Serve on the same machine;
# 0.0.0.0 makes it reachable from the LAN.
ROOMCAST_HOST=127.0.0.1
ROOMCAST_PORT=8765
# Unguessable path segment: the MCP endpoint becomes /<secret>/mcp. Needed for chat connectors
# (claude.ai), which cannot send a token. Generate with: openssl rand -hex 16
ROOMCAST_PATH_SECRET=
# Optional bearer token, for clients that can send an Authorization header (Claude Code,
# Cursor, ...). Every request must then carry it. Generate with: openssl rand -hex 32
ROOMCAST_TOKEN=
# Public hostname (e.g. roomcast.tail1234.ts.net): turns on the Host-header check.
ROOMCAST_PUBLIC_HOST=

# Only for the tailscale compose profile.
TS_AUTHKEY=
TS_HOSTNAME=roomcast
